  },
  "jsnbversion": "v0.1",
  "cells": [
    {
      "code": "//> module\n\n/*\n * Creeping Flow in a 2D Lid-Driven Cavity\n *\n * This example simulates steady Stokes flow (creeping flow) in a two-dimensional\n * lid-driven cavity using the FEAScript library with the \"creepingFlowScript\" solver.\n *\n * The problem is governed by the steady Stokes equations for incompressible flow:\n *     ∇ · u = 0\n *     -μ ∇²u + ∇p = 0\n * where u = (u,v) is the velocity vector, p is pressure, and μ=1.0 (dynamic viscosity).\n *\n * Domain: rectangle 4 m × 2 m, discretized with Taylor-Hood mixed finite elements\n * (Q2 for velocity, Q1 for pressure) on a 12×6 mesh.\n *\n * Boundary conditions (no-slip except top lid):\n *   - Bottom (y=0):          u=0, v=0 (no-slip)\n *   - Left   (x=0):          u=0, v=0 (no-slip)\n *   - Right  (x=4):          u=0, v=0 (no-slip)\n *   - Top    (y=2):          u=1, v=0 (moving lid)\n *\n * For a detailed mathematical formulation and more background, see the\n * official FEAScript tutorial:\n * https://feascript.com/tutorials/lid-driven-cavity-2d-creeping-flow.html\n */\n\n// Import FEAScript library\nimport { FEAScriptModel, plotSolution, printVersion } from \"https://core.feascript.com/dist/feascript.esm.js\";\n\nconsole.log(\"FEAScript version:\", printVersion);\n\n// 1. Create the model and select the physics\nconst model = new FEAScriptModel();\nmodel.setModelConfig(\"creepingFlowScript\");\n\n// 2. Define the mesh (creeping flow needs quadratic elements)\nmodel.setMeshConfig({\n  meshDimension: \"2D\",\n  elementOrder: \"quadratic\",\n  numElementsX: 12,\n  numElementsY: 6,\n  maxX: 4,\n  maxY: 2,\n});\n\n// 3. Apply the boundary conditions\nmodel.addBoundaryCondition(\"0\", [\"constantVelocity\", 0, 0]); // Bottom wall\nmodel.addBoundaryCondition(\"1\", [\"constantVelocity\", 0, 0]); // Left wall\nmodel.addBoundaryCondition(\"2\", [\"constantVelocity\", 1, 0]); // Moving lid\nmodel.addBoundaryCondition(\"3\", [\"constantVelocity\", 0, 0]); // Right wall\n\n// 4. Solve\nmodel.setSolverMethod(\"lusolve\");\nconst result = model.solve();\n\n// 5. Plot the results\nscrib.show(`\n  <style>\n    .feascript-example { font-family: \"Roboto\", sans-serif; color: #333; }\n    .feascript-example h1 { font-size: 1.5em; line-height: 1.2em; font-weight: normal; padding: 0.4em 0 0.2em; margin: 0 0 0.5em; color: #555; text-align: left; }\n    .feascript-example h3 { font-weight: normal; color: #555; }\n    .feascript-example .description { max-width: 600px; margin: 0 0 1em; padding: 0 1em; text-align: left; }\n    .feascript-example .description p { font-size: 1em; line-height: 1.5em; color: #555; }\n    .feascript-example .results { max-width: 600px; margin-top: 20px; }\n  </style>\n  <div class=\"feascript-example\">\n    <h1>Creeping Flow in a 2D Lid-Driven Cavity</h1>\n    <div class=\"description\">\n      <p>This example simulates steady-state creeping (Stokes) flow in a 2D rectangular cavity using the <a href=\"https://feascript.com/\" target=\"_blank\">FEAScript library</a>. The top lid moves at a constant horizontal velocity, while the other three walls remain stationary. The simulation uses Taylor-Hood mixed finite elements to solve for the velocity field.</p>\n    </div>\n    <h3>Velocity Magnitude</h3>\n    <div id=\"velocityMagnitudeCanvas\" class=\"results\"></div>\n    <h3>Horizontal Velocity (u)</h3>\n    <div id=\"uVelocityCanvas\" class=\"results\"></div>\n    <h3>Vertical Velocity (v)</h3>\n    <div id=\"vVelocityCanvas\" class=\"results\"></div>\n    <div class=\"description\">\n      <p>\n        For a rigorous mathematical formulation and theory, see the\n        <a href=\"https://feascript.com/tutorials/lid-driven-cavity-2d-creeping-flow.html\" target=\"_blank\">basic tutorial</a> at the FEAScript website.\n      </p>\n    </div>\n  </div>\n`);\nplotSolution(model, result, \"contour\", \"velocityMagnitudeCanvas\");\nplotSolution(model, result, \"contour\", \"uVelocityCanvas\", { field: \"u\" });\nplotSolution(model, result, \"contour\", \"vVelocityCanvas\", { field: \"v\" });\n",
      "status": "[5]<br><span style=\"font-size:8px\">2ms<span></span></span>",
      "output": " <div class=\"plot-container plotly\"><div class=\"user-select-none svg-container\" style=\"position: relative; width: 1509px; height: 520px;\"><svg class=\"main-svg\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1509\" height=\"520\" style=\"background: rgb(255, 255, 255);\"><defs id=\"defs-64a313\"><g class=\"clips\"><clipPath id=\"clip64a313xyplot\" class=\"plotclip\"><rect width=\"1276\" height=\"420\"></rect></clipPath><clipPath class=\"axesclip\" id=\"clip64a313x\"><rect x=\"50\" y=\"0\" width=\"1276\" height=\"520\"></rect></clipPath><clipPath class=\"axesclip\" id=\"clip64a313y\"><rect x=\"0\" y=\"50\" width=\"1509\" height=\"420\"></rect></clipPath><clipPath class=\"axesclip\" id=\"clip64a313xy\"><rect x=\"50\" y=\"50\" width=\"1276\" height=\"420\"></rect></clipPath><clipPath class=\"contourlineclip\" id=\"cliplinebf91ab\"><path d=\"M0,0L1276,0L1276,420L0,420ZM990.5195283632617,370.9406466347059L993.3374576456678,383.2898862470789L1012.3162870664258,378.95917432883573L1009.4983577840197,366.6099347164627ZM375.28876899813173,126.98879215518434L377.71094466532935,139.42171254750087L396.81837821866515,135.69921138485472L394.3962025514675,123.26629099253819ZM613.0846898773138,358.8296224283515L613.077275425278,371.49628692498777L633.0939396799779,371.50800371097137L633.1013541320137,358.8413392143351ZM46.87377799090988,346.4251759549578L46.68318450340623,359.0904086242366L66.69758609396968,359.3915965059797L66.88817958147334,346.7263638367009ZM1016.2659702830928,86.27792667483621L1013.5512377269989,98.65026160375439L1033.1027837859176,102.94025366370545L1035.8175163420112,90.56791873478727ZM167.95119602122617,51.51851403154098L166.43318869390777,64.0938906938383L186.30559413990665,66.49274186852413L187.82360146722505,53.91736520622681ZM46.475151830647576,390.56590297529067L46.436085086238194,403.23250939666195L66.45265756673199,403.29424513668846L66.49172431114137,390.6276387153172ZM810.927852655314